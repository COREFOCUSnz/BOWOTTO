<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        No INTERNET permission, by design. Nothing in the vault can ever leave
        the device over the network, and the absence of the permission is
        verifiable by anyone who inspects the APK. CI asserts it on every build.

        No READ_MEDIA_IMAGES / READ_EXTERNAL_STORAGE either: importing goes
        through the system photo picker, which hands back a single-URI grant.

        This file declares no <uses-permission> at all, but the merged manifest
        is not empty: androidx.core adds
        <app id>.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION, which is signature-
        protected and in our own namespace, so it grants nothing. See
        docs/SECURITY.md - the point being that what this file says is not the
        same as what ships.
    -->

    <application
        android:name=".FirewallApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:hasFragileUserData="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Firewall">

        <!-- The only exported component: the game. -->
        <activity
            android:name=".game.TetrisActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".lock.PasscodeActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode" />

        <activity
            android:name=".vault.VaultActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode" />
    </application>

</manifest>
