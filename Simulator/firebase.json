{
  "hosting": {
    "public": "dist/hosting",
    "ignore": ["firebase.json", "**/.*"],
    "cleanUrls": true,
    "headers": [
      { "source": "**/*.@(glb|webm|mp4|png|jpg|webp)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
      { "source": "index.html", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] }
    ]
  }
}
